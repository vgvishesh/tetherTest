NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/price-aggregator
# MONGODB_DB_NAME=price-aggregator
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Defaults to true outside production
# MONGODB_AUTO_INDEX=true

COINGECKO_BASE_URL=https://api.coingecko.com/
# Free Demo key from https://www.coingecko.com/en/developers/dashboard
# Without it you share an IP-wide keyless quota and will hit HTTP 429 quickly.
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_MS=10000

# Scheduled aggregation: a run is kicked off every AGGREGATION_INTERVAL_MS
# starting once the server has booted.
AGGREGATION_INTERVAL_MS=30000
# Set to false to boot without the scheduler (manual POST /prices/run-aggregation only)
AGGREGATION_ENABLED=true
